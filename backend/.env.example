# Skopiuj ten plik do .env i uzupelnij wartosci.

# Port serwera backendu
PORT=4002

# Adres frontendu (do CORS)
CORS_ORIGIN=http://localhost:5175

# Polaczenie do bazy.
# - natywnie (npm run dev): Postgres na hoscie, port 5435 (mapowanie z docker-compose).
# - w kontenerze (docker compose): host to nazwa uslugi 'db' na porcie 5432 —
#   ta wartosc jest ustawiana w docker-compose.yml, nie tutaj.
DATABASE_URL="postgresql://postgres:password@localhost:5435/planista8?schema=public"

# Sekrety JWT — w produkcji uzyj dlugich, losowych wartosci
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Error-tracking (opcjonalnie w dev). Pusty/brak = wylaczone (kod jest wtedy no-op).
# Ustaw, gdy chcesz przetestowac wysylanie bledow lokalnie.
SENTRY_DSN=
