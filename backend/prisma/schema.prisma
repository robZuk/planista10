// ═══════════════════════════════════════════════════════════════
//  ZGLOSZENIA ZMIAN I POWIADOMIENIA
// ═══════════════════════════════════════════════════════════════

// Prowadzacy prosi dziekanat o odwolanie albo przeniesienie swojego terminu, albo proponuje
// termin odrobienia odwolanych zajec. Dziekanat zatwierdza (zmiana wykonuje sie wtedy,
// z pelnym sprawdzeniem kolizji) albo odrzuca z uzasadnieniem.
model ChangeRequest {
  id                  String              @id @default(uuid())
  term                AcademicTerm        @relation(fields: [termId], references: [id])
  termId              String
  faculty             Faculty             @relation(fields: [facultyId], references: [id])
  facultyId           String
  section             ClassSection        @relation(fields: [sectionId], references: [id])
  sectionId           String
  instructor          Instructor          @relation(fields: [instructorId], references: [id])
  instructorId        String
  requestedBy         User?               @relation("RequestAuthor", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById       String?
  kind                ChangeRequestKind
  status              ChangeRequestStatus @default(PENDING)
  // Termin, ktorego dotyczy: trwaly klucz (lib/occurrenceKey) i jego stan w chwili zgloszenia
  // (do wyswietlania, gdyby termin zniknal przy ponownym generowaniu).
  occurrenceKey       String
  originalDate        DateTime            @db.Date
  originalStartMinute Int
  originalEndMinute   Int
  // Propozycja (MOVE, MAKEUP): data i bloki siatki rocznika; sala albo online.
  newDate             DateTime?           @db.Date
  newStartOrder       Int?
  newEndOrder         Int?
  newRoom             Room?               @relation(fields: [newRoomId], references: [id], onDelete: SetNull)
  newRoomId           String?
  newOnline           Boolean             @default(false)
  reason              String
  decidedBy           User?               @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  notifications       Notification[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([facultyId, status])
  @@index([instructorId, status])
  @@index([occurrenceKey])
}

// Powiadomienie w aplikacji (dzwonek w naglowku). Tworza je zgloszenia i zmiany terminow
// prowadzacego wprowadzone przez dziekanat.
model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      NotificationKind
  title     String
  body      String
  // Sciezka w aplikacji, np. "/requests/2026-Z".
  link      String?
  request   ChangeRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  requestId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

enum ChangeRequestKind {
  CANCEL // odwolanie terminu
  MOVE // przeniesienie terminu
  MAKEUP // termin odrobienia odwolanych zajec
}

enum ChangeRequestStatus {
  PENDING // czeka na dziekanat
  APPROVED // zatwierdzone i wykonane
  REJECTED // odrzucone (z uzasadnieniem)
  WITHDRAWN // wycofane przez prowadzacego
  SUPERSEDED // nieaktualne: planista zmienil termin wprost, inaczej niz w prosbie
}

enum NotificationKind {
  REQUEST_CREATED // do dziekanatu: nowe zgloszenie
  REQUEST_WITHDRAWN // do dziekanatu: prowadzacy wycofal zgloszenie
  REQUEST_APPROVED // do prowadzacego
  REQUEST_REJECTED // do prowadzacego
  REQUEST_SUPERSEDED // do prowadzacego: termin zmieniony wprost, zgloszenie nieaktualne
  CLASS_CANCELLED // do prowadzacego: dziekanat odwolal jego zajecia
  CLASS_CHANGED // do prowadzacego: dziekanat przeniosl / przywrocil jego zajecia
  MAKEUP_SCHEDULED // do prowadzacego: dziekanat dodal termin (odrobienie) z jego udzialem
}
