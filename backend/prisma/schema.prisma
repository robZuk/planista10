// Prisma schema — model danych systemu Planista.
// Dokumentacja: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  STRUKTURA UCZELNI
//  Wydzial -> Kierunek -> Specjalnosc
// ═══════════════════════════════════════════════════════════════

model Faculty {
  id            String         @id @default(uuid())
  name          String         @unique // "Wydzial Mechaniczny"
  shortName     String         @unique // "WM"
  buildings     Building[]
  instructors   Instructor[]
  fieldsOfStudy FieldOfStudy[]
  users         User[]

  // Wydzial jest jednostka organizacyjna planu: kalendarze semestru, zajecia,
  // umieszczenia i terminy naleza do konkretnego wydzialu.
  termCalendars  TermCalendar[]
  timeGrids      TimeGrid[]
  classSections  ClassSection[]
  placements     Placement[]
  occurrences    Occurrence[]
  changeRequests ChangeRequest[]

  createdAt DateTime @default(now())
}

model FieldOfStudy {
  id              String           @id @default(uuid())
  name            String // "Eksploatacja i Diagnostyka Systemow Technicznych"
  shortName       String // "EDST"
  faculty         Faculty          @relation(fields: [facultyId], references: [id])
  facultyId       String
  specializations Specialization[]
  programs        Program[]
  createdAt       DateTime         @default(now())

  @@unique([name, facultyId])
}

model Specialization {
  id             String         @id @default(uuid())
  name           String // "Diagnostyka Urzadzen Technicznych"
  shortName      String // "DUT"
  fieldOfStudy   FieldOfStudy   @relation(fields: [fieldOfStudyId], references: [id])
  fieldOfStudyId String
  studentGroups  StudentGroup[]
  programEntries ProgramEntry[]
  createdAt      DateTime       @default(now())

  @@unique([name, fieldOfStudyId])
}

// ═══════════════════════════════════════════════════════════════
//  SLOWNIK PRZEDMIOTOW (wspolny dla calej uczelni)
// ═══════════════════════════════════════════════════════════════

model Subject {
  id             String         @id @default(uuid())
  name           String         @unique // "Matematyka I"
  code           String?        @unique // opcjonalny kod przedmiotu
  programEntries ProgramEntry[]
  createdAt      DateTime       @default(now())
}

// ═══════════════════════════════════════════════════════════════
//  PROGRAM STUDIOW 
//
//  Program = kierunek + poziom + tryb. Wersja programu obowiazuje WIELE rocznikow
//  (nie jest kopiowana co rok); zmiana programu = nowa wersja sklonowana z poprzedniej.
//  Przedmioty wspolne dla kierunku maja specializationId = null, specjalnosciowe —
//  wskazuja specjalnosc. Prowadzacy NIE nalezy do programu (to obsada zajec).
// ═══════════════════════════════════════════════════════════════

model Program {
  id             String           @id @default(uuid())
  code           String           @unique // "EDST-S1"
  name           String
  fieldOfStudy   FieldOfStudy     @relation(fields: [fieldOfStudyId], references: [id])
  fieldOfStudyId String
  degreeLevel    DegreeLevel
  studyMode      StudyMode
  versions       ProgramVersion[]
  cohorts        Cohort[]
  createdAt      DateTime         @default(now())
}

model ProgramVersion {
  id               String               @id @default(uuid())
  program          Program              @relation(fields: [programId], references: [id])
  programId        String
  label            String // "od naboru 2024/25"
  status           ProgramVersionStatus @default(DRAFT)
  totalSemesters   Int
  // Typ semestru, od ktorego zwykle startuje nabor (domyslny dla nowych rocznikow).
  defaultStartType SemesterType         @default(WINTER)
  clonedFrom       ProgramVersion?      @relation("VersionClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clonedFromId     String?
  clones           ProgramVersion[]     @relation("VersionClone")
  entries          ProgramEntry[]
  cohorts          Cohort[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([programId, label])
}

model ProgramEntry {
  id               String          @id @default(uuid())
  version          ProgramVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId        String
  subject          Subject         @relation(fields: [subjectId], references: [id])
  subjectId        String
  semester         Int
  // null = przedmiot wspolny dla calego kierunku
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
  specializationId String?
  orderInSemester  Int

  hoursLecture   Int            @default(0)
  hoursExercise  Int            @default(0)
  hoursLab       Int            @default(0)
  hoursProject   Int            @default(0)
  hoursSeminar   Int            @default(0)
  ects           Int            @default(0)
  assessmentType AssessmentType @default(CREDIT)

  sections ClassSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unikalnosc (versionId, subjectId, semester, specializationId) z NULLS NOT DISTINCT
  // jest zalozona surowym SQL w migracji — Prisma tego nie wyraza.
  @@index([versionId, semester])
}

// ═══════════════════════════════════════════════════════════════
//  BUDYNKI I SALE
// ═══════════════════════════════════════════════════════════════

model Building {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  facultyId String?
  rooms     Room[]
  createdAt DateTime @default(now())
}

model Room {
  id              String          @id @default(uuid())
  number          String
  type            RoomType
  capacity        Int
  building        Building        @relation(fields: [buildingId], references: [id])
  buildingId      String
  placements      Placement[]
  occurrences     Occurrence[]
  preferredGroups StudentGroup[]
  changeRequests  ChangeRequest[]
  createdAt       DateTime        @default(now())

  @@unique([number, buildingId])
}

// ═══════════════════════════════════════════════════════════════
//  PROWADZACY
// ═══════════════════════════════════════════════════════════════

model Instructor {
  id                 String              @id @default(uuid())
  firstName          String
  lastName           String
  email              String              @unique
  title              String? // "prof. dr hab."
  faculty            Faculty?            @relation(fields: [facultyId], references: [id])
  facultyId          String?
  user               User? // opcjonalne konto logowania
  sectionAssignments SectionInstructor[]
  placements         Placement[]
  occurrences        Occurrence[]
  changeRequests     ChangeRequest[]
  createdAt          DateTime            @default(now())
}

// ═══════════════════════════════════════════════════════════════
//  BLOKI CZASOWE (kategoria zarzadzalna przez admina)
//  Siatka planu opiera sie wylacznie na tych 1-godzinnych blokach.
//  Zajecia zaczynaja i koncza sie na granicy bloku (pelna godzina).
// ═══════════════════════════════════════════════════════════════

// Siatka godzin wydzialu dla trybu studiow (kazdy wydzial: stacjonarna i niestacjonarna).
// Bloki o dowolnym starcie i dlugosci; przerwy to odstepy miedzy blokami. `days` — dni zajec
// z opcjonalnym oknem godzin, np. [{"day":"THURSDAY","from":"16:00","to":null}, ...].
model TimeGrid {
  id        String      @id @default(uuid())
  faculty   Faculty     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  facultyId String
  studyMode StudyMode
  days      Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  blocks    TimeBlock[]

  @@unique([facultyId, studyMode])
}

model TimeBlock {
  id        String   @id @default(uuid())
  grid      TimeGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)
  gridId    String
  order     Int // kolejnosc w siatce: 1, 2, 3, ... (rosnaco wg godziny)
  startTime String // "08:00" — dowolna minuta
  endTime   String // "08:45"
  label     String // "08:00-08:45"
  createdAt DateTime @default(now())
  // Umieszczenia wskazuja bloki siatki wydzialu i trybu rocznika przez `order` (startOrder..endOrder
  // wlacznie). 1 blok = 1 godzina programu, niezaleznie od dlugosci w minutach.

  @@unique([gridId, order])
  @@unique([gridId, startTime])
}

// ═══════════════════════════════════════════════════════════════
//  SEMESTRY I KALENDARZE 
//
//  Semestr kalendarzowy (AcademicTerm) to jedyny kontekst czasowy planowania.
//  Kazdy wydzial ma w nim kalendarze per tryb studiow (i ewentualne warianty,
//  np. inne zjazdy dla czesci kierunkow). Swieta ustawowe NIE sa tu zapisywane —
//  liczy je lib/holidays.ts. 
// ═══════════════════════════════════════════════════════════════

model AcademicTerm {
  id             String             @id @default(uuid())
  startYear      Int // 2026 -> rok akademicki 2026/2027
  type           SemesterType // WINTER = zimowy, SUMMER = letni
  calendars      TermCalendar[]
  startedCohorts Cohort[]
  cohortTerms    CohortTerm[]
  generations    CohortGeneration[]
  sections       ClassSection[]
  placements     Placement[]
  occurrences    Occurrence[]
  changeRequests ChangeRequest[]
  createdAt      DateTime           @default(now())

  @@unique([startYear, type])
}

model TermCalendar {
  id        String         @id @default(uuid())
  term      AcademicTerm   @relation(fields: [termId], references: [id], onDelete: Restrict)
  termId    String
  faculty   Faculty        @relation(fields: [facultyId], references: [id])
  facultyId String
  studyMode StudyMode
  // Nazwa wariantu w obrebie wydzialu i trybu: "Podstawowy", "Zjazdy B"...
  name      String         @default("Podstawowy")
  kind      CalendarKind // WEEKLY = rytm tygodniowy, ZJAZD = zajecia na zjazdach
  status    CalendarStatus @default(PLANNING)
  startDate DateTime       @db.Date
  endDate   DateTime       @db.Date

  breaks      CalendarBreak[]
  days        CalendarDay[]
  zjazdy      Zjazd[]
  cohortTerms CohortTerm[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Ostatnia zmiana dat (rodzaj, daty semestru, przerwy, dni, zjazdy) — nie nazwy ani statusu.
  // Pozniejsza niz generowanie rocznika = jego terminy nieaktualne (services/staleness).
  datesChangedAt  DateTime  @default(now())
  // Kiedy ostatnio generowano terminy wg tego kalendarza (dowolnego rocznika) — informacyjnie.
  // "Terminy nieaktualne" liczymy per rocznik z CohortGeneration.
  lastGeneratedAt DateTime?

  @@unique([termId, facultyId, studyMode, name])
  @@index([facultyId])
}

// Przerwa w zajeciach (np. swiateczna) — zakres dat wlacznie.
model CalendarBreak {
  id         String       @id @default(uuid())
  calendar   TermCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId String
  name       String
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date
}

// Wyjatek pojedynczego dnia: dzien wolny (rektorski/dziekanski), zamiana dni
// ("piatek wg planu poniedzialku") albo godziny rektorskie od wskazanego bloku.
model CalendarDay {
  id                   String          @id @default(uuid())
  calendar             TermCalendar    @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId           String
  date                 DateTime        @db.Date
  kind                 CalendarDayKind
  name                 String?
  followsWeekday       DayOfWeek?
  closedFromBlockOrder Int?

  @@unique([calendarId, date])
}

model Zjazd {
  id         String       @id @default(uuid())
  calendar   TermCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId String
  number     Int
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date

  @@unique([calendarId, number])
}

// ═══════════════════════════════════════════════════════════════
//  GRUPY STUDENTOW (z hierarchia rodzic -> dziecko)
// ═══════════════════════════════════════════════════════════════

model StudentGroup {
  id String @id @default(uuid())

  // Grupa nalezy do rocznika i idzie z nim przez cale studia. Nazwa NIE jest
  // zapisywana — liczy ja lib/groupTree.ts (displayName) z rocznika i semestru.
  cohort           Cohort          @relation(fields: [cohortId], references: [id])
  cohortId         String
  // Podzial: ROOT (caly rocznik), SPEC, C, L, P, S albo wlasny (np. JEZ).
  partitionKey     String
  code             String? // "A", "A1", "DUT"
  // Specjalnosc — dla grupy SPEC i jej potomkow (dziedziczona przy zakladaniu).
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
  specializationId String?
  // Zakres obowiazywania: scalenia, podzial na specjalnosci od semestru k.
  fromSemester     Int             @default(1)
  toSemester       Int? // null = do konca studiow
  size             Int

  // Hierarchia: grupy tego samego podzialu pod jednym rodzicem sa rozlaczne.
  parentGroup   StudentGroup?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  parentGroupId String?
  subGroups     StudentGroup[] @relation("GroupHierarchy")

  preferredRoom   Room?   @relation(fields: [preferredRoomId], references: [id])
  preferredRoomId String?

  members     User[]         @relation("StudentGroupMembers")
  sections    ClassSection[]
  occurrences Occurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cohortId])
}

// ═══════════════════════════════════════════════════════════════
//  ROCZNIKI 
//
//  Rocznik = jeden nabor na program, startujacy w konkretnym semestrze. Numer semestru
//  programu w dowolnym semestrze kalendarzowym wynika z roznicy (lib/terms.ts), wiec
//  nabor lutowy dziala bez reguly "nieparzysty = zima". Grupy naleza do rocznika.
// ═══════════════════════════════════════════════════════════════

model Cohort {
  id               String             @id @default(uuid())
  program          Program            @relation(fields: [programId], references: [id])
  programId        String
  programVersion   ProgramVersion     @relation(fields: [programVersionId], references: [id])
  programVersionId String
  startTerm        AcademicTerm       @relation(fields: [startTermId], references: [id])
  startTermId      String
  name             String? // opcjonalna wlasna nazwa; domyslnie liczona
  // Wyklady przedmiotow wspolnych: razem dla calego rocznika czy osobno per specjalnosc.
  lectureMode      CohortLectureMode  @default(SEPARATE)
  groups           StudentGroup[]
  terms            CohortTerm[]
  generations      CohortGeneration[]
  sections         ClassSection[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([programId, startTermId])
}

// ═══════════════════════════════════════════════════════════════
//  ZAJECIA I OBSADA 
//
//  ClassSection = jedna rzecz do przeprowadzenia w semestrze: przedmiot z programu,
//  forma zajec i grupa rocznika (np. Fizyka I, laboratorium, DUT-1-L-A1, 30 h).
//  Wyliczana z programu i grup (synchronizacja), godziny to kopia z programu — zmiana
//  programu nie przepisuje przeszlych semestrow. Obsada (SectionInstructor) to osobny
//  etap: kto prowadzi ile godzin; instructorId = null oznacza NN (wakat).
// ═══════════════════════════════════════════════════════════════

model ClassSection {
  id             String              @id @default(uuid())
  term           AcademicTerm        @relation(fields: [termId], references: [id])
  termId         String
  cohort         Cohort              @relation(fields: [cohortId], references: [id])
  cohortId       String
  programEntry   ProgramEntry        @relation(fields: [programEntryId], references: [id])
  programEntryId String
  classType      ClassType
  group          StudentGroup        @relation(fields: [groupId], references: [id])
  groupId        String
  hours          Int
  faculty        Faculty             @relation(fields: [facultyId], references: [id])
  facultyId      String
  status         SectionStatus       @default(ACTIVE)
  instructors    SectionInstructor[]
  placements     Placement[]
  occurrences    Occurrence[]
  changeRequests ChangeRequest[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([termId, programEntryId, classType, groupId])
  @@index([termId, facultyId])
}

model SectionInstructor {
  id           String       @id @default(uuid())
  section      ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId    String
  instructor   Instructor?  @relation(fields: [instructorId], references: [id])
  instructorId String? // null = NN (wakat)
  hours        Int
}

// ═══════════════════════════════════════════════════════════════
//  PLAN 
//
//  Placement = umieszczenie zajec we wzorcu: dzien, bloki (order), sala, prowadzacy
//  i rytm (co tydzien / parzyste / nieparzyste / wybrane tygodnie, albo kazdy zjazd /
//  wybrane zjazdy). Uklada je wylacznie planista — system niczego nie wstawia sam.
//  Occurrence = konkretny termin. Terminy DERIVED powstaja TYLKO po "Generuj terminy";
//  reczne poprawki pojedynczych terminow to PlacementException (przezywaja ponowne
//  generowanie), a odrobienia/terminy jednorazowe to Occurrence MANUAL.
// ═══════════════════════════════════════════════════════════════

model Placement {
  id           String               @id @default(uuid())
  section      ClassSection         @relation(fields: [sectionId], references: [id])
  sectionId    String
  term         AcademicTerm         @relation(fields: [termId], references: [id])
  termId       String
  faculty      Faculty              @relation(fields: [facultyId], references: [id])
  facultyId    String
  dayOfWeek    DayOfWeek
  startOrder   Int // TimeBlock.order — blok poczatkowy
  endOrder     Int // blok koncowy (wlacznie)
  room         Room?                @relation(fields: [roomId], references: [id])
  roomId       String? // null = zajecia online (bez sali)
  instructor   Instructor?          @relation(fields: [instructorId], references: [id])
  instructorId String? // z obsady zajec; null = NN
  cycle        PlacementCycle       @default(WEEK)
  pattern      PlacementPattern     @default(ALL)
  numbers      Int[] // dla LIST: numery tygodni albo zjazdow
  fromIndex    Int?
  toIndex      Int?
  // Zajecia laczone miedzy kierunkami/trybami: umieszczenia o tym samym kluczu maja
  // identyczny czas, sale i prowadzacego i nie koliduja ze soba.
  jointKey     String?
  exceptions   PlacementException[]
  occurrences  Occurrence[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([termId, facultyId])
  @@index([sectionId])
}

model PlacementException {
  id              String          @id @default(uuid())
  placement       Placement       @relation(fields: [placementId], references: [id], onDelete: Cascade)
  placementId     String
  originalDate    DateTime        @db.Date
  action          ExceptionAction
  newDate         DateTime?       @db.Date
  newStartOrder   Int?
  newEndOrder     Int?
  newRoomId       String?
  newOnline       Boolean? // true = termin przeniesiony na online (bez sali); null = bez zmiany
  newInstructorId String?
  note            String?
  createdAt       DateTime        @default(now())

  @@unique([placementId, originalDate])
}

model Occurrence {
  id           String         @id @default(uuid())
  term         AcademicTerm   @relation(fields: [termId], references: [id])
  termId       String
  faculty      Faculty        @relation(fields: [facultyId], references: [id])
  facultyId    String
  section      ClassSection   @relation(fields: [sectionId], references: [id])
  sectionId    String
  placement    Placement?     @relation(fields: [placementId], references: [id], onDelete: SetNull)
  placementId  String?
  originalDate DateTime?      @db.Date // data z wzorca (przed wyjatkiem)
  date         DateTime       @db.Date
  startOrder   Int
  endOrder     Int
  // Rzeczywisty czas (minuty od polnocy) z siatki rocznika w chwili zapisu — kolizje miedzy
  // siatkami roznych wydzialow i "Moj plan" licza sie w minutach.
  startMinute  Int
  endMinute    Int
  room         Room?          @relation(fields: [roomId], references: [id])
  roomId       String? // null = zajecia online (bez sali)
  instructor   Instructor?    @relation(fields: [instructorId], references: [id])
  instructorId String?
  group        StudentGroup   @relation(fields: [groupId], references: [id])
  groupId      String
  kind         OccurrenceKind @default(DERIVED)
  status       EntryStatus    @default(SCHEDULED)
  jointKey     String?
  note         String?
  // Odrobienie (MANUAL, MAKEUP) za odwolany termin — jego trwaly klucz (lib/occurrenceKey):
  // "p:<umieszczenie>|<data z wzorca>" albo "o:<id terminu recznego>". Terminy z wzorca dostaja
  // nowe id przy kazdym "Generuj terminy", wiec nie wskazujemy ich kluczem obcym. Odrobienie
  // z kluczem nie zuzywa godzin drugi raz — odwolany termin juz je zuzyl.
  makeupOfKey  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([termId, facultyId])
  @@index([date, roomId])
  @@index([date, instructorId])
  @@index([sectionId])
  @@index([makeupOfKey])
}

// Rocznik w konkretnym semestrze: numer semestru programu (wyliczany, wyjatkowo do
// recznej korekty) i kalendarz, wg ktorego ma zajecia (tydzien / wariant zjazdow).
model CohortTerm {
  id         String        @id @default(uuid())
  cohort     Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  cohortId   String
  term       AcademicTerm  @relation(fields: [termId], references: [id])
  termId     String
  semester   Int
  calendar   TermCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarId String?
  // Ostatnia zmiana numeru semestru albo kalendarza (null = nie zmieniano). Pozniejsza niz
  // generowanie rocznika = jego terminy nieaktualne (services/staleness).
  changedAt  DateTime?

  @@unique([cohortId, termId])
}

// Ostatnie "Generuj terminy" rocznika w semestrze — od niego liczymy "terminy nieaktualne"
// (lib/planStaleness). Osobno dla kazdego rocznika: kalendarz dzieli wiele rocznikow, a
// generowanie z planu przelicza tylko jeden, wiec znacznik na kalendarzu falszywie
// "odswiezal" pozostale roczniki.
model CohortGeneration {
  id          String       @id @default(uuid())
  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  cohortId    String
  term        AcademicTerm @relation(fields: [termId], references: [id])
  termId      String
  generatedAt DateTime
  // Odcisk kalendarza z chwili generowania (services/staleness.calendarFingerprint): zmiana
  // tam i z powrotem nie unieaktualnia terminow. null = generowanie sprzed tej kolumny.
  calendarKey String?

  @@unique([cohortId, termId])
}

// ═══════════════════════════════════════════════════════════════
//  AUTH — uzytkownicy i tokeny odswiezania
// ═══════════════════════════════════════════════════════════════

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // hash bcrypt
  role     Role
  name     String

  // Konto INSTRUCTOR moze byc powiazane z rekordem Instructor (1:1)
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  instructorId String?     @unique

  // Konto DEAN_OFFICE moze byc przypisane do wydzialu (ogranicza je do wlasnego wydzialu)
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  facultyId String?

  // Konto STUDENT moze nalezec do wielu grup (M:N)
  studentGroups StudentGroup[] @relation("StudentGroupMembers")

  refreshTokens RefreshToken[]

  requestsMade    ChangeRequest[] @relation("RequestAuthor")
  requestsDecided ChangeRequest[] @relation("RequestDecider")
  notifications   Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

